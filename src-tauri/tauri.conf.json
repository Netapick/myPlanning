{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myPlanning",
  "version": "1.0.5",
  "identifier": "com.myplanning.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myPlanning",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": "64A229F3F95F4DA84E59B9E8BDD59C53C2C56450",
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMzAwRDdERjQ3MzUzQUMKUldTc1UzUDBmUTB3MjBXMDAwMjN0c1UyR2Fkd2lwZHpvaGsxSHdrRVJqa296RkFyRnlSRkJpbEcK",
      "endpoints": ["https://github.com/Netapick/myPlanning/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
